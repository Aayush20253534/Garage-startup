{
  "name": "rovauto-server",
  "version": "1.0.0",
  "description": "Backend API for the Rovauto vehicle service platform",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",

    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "prisma:studio": "prisma studio",

    "seed:admin": "node src/seed/seedAdmin.js",
    "seed:intern": "node src/seed/seedIntern.js",
    "seed:staff": "npm run seed:admin && npm run seed:intern",
    "seed:all": "npm run seed:staff",

    "db:delete-user": "node src/scripts/deleteUserData.js",
    "db:delete-active-bookings": "node src/scripts/deleteCustomerRecords.js --scope=active-bookings",
    "db:delete-payments": "node src/scripts/deleteCustomerRecords.js --scope=payments",
    "db:delete-service-history": "node src/scripts/deleteCustomerRecords.js --scope=service-history",
    "db:delete-garages": "node src/scripts/adminCleanup.js --scope=garages",
    "db:delete-price-ranges": "node src/scripts/adminCleanup.js --scope=price-ranges",
    "db:delete-bookings": "node src/scripts/adminCleanup.js --scope=bookings",
    "db:delete-notifications": "node src/scripts/adminCleanup.js --scope=notifications",
    "db:nuke-users": "node src/scripts/nukeUsersData.js",
    "db:approve-garage": "node src/scripts/approveGarageApplication.js",
    "db:activate-garage": "node src/scripts/activateGarage.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aayush20253534/Garage-startup.git"
  },
  "keywords": [
    "rovauto",
    "vehicle-service",
    "garage",
    "express",
    "prisma",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Aayush20253534/Garage-startup/issues"
  },
  "homepage": "https://github.com/Aayush20253534/Garage-startup#readme",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "argon2": "^0.44.0",
    "axios": "^1.18.0",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dayjs": "^1.11.21",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "firebase-admin": "^14.1.0",
    "groq-sdk": "^1.3.0",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "resend": "^6.14.0",
    "streamifier": "^0.1.1",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "@hono/node-server": "1.19.13"
  }
}