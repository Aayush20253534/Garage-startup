generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String                @id @default(uuid())
  name                 String
  email                String
  phone                String?
  password             String
  role                 Role                  @default(CUSTOMER)
  isEmailVerified      Boolean               @default(false)
  isPhoneVerified      Boolean               @default(false)
  isOnboarded          Boolean               @default(false)
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  bookings             Booking[]
  complaints           Complaint[]
  locations            CustomerLocation[]
  customerProfile      CustomerProfile?
  ownedGarages         Garage[]
  notifications        Notification[]
  pushSubscriptions    PushSubscription[]
  sessions             UserSession[]
  otps                 Otp[]
  reviews              Review[]
  vehicles             Vehicle[]
  wallet               Wallet?
  walletTransactions   WalletTransaction[]
  chatbotConversations ChatbotConversation[]
  chatbotMessages      ChatbotMessage[]
  customerActivities   CustomerActivity[]
  trackingPoints       BookingTrackingPoint[]
  supportTickets       SupportTicket[]
  supportTicketMessages SupportTicketMessage[] @relation("SupportTicketUserMessages")

  @@unique([email, role])
  @@unique([phone, role])
  @@index([email])
  @@index([phone])
}

model UserSession {
  id         String    @id @default(uuid())
  userId     String
  userAgent  String?
  deviceId   String?
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, deviceId])
  @@index([lastSeenAt])
  @@map("user_sessions")
}

model StaffAccount {
  id                String    @id @default(uuid())
  name              String
  loginId           String    @unique
  email             String?   @unique
  phone             String?   @unique
  password          String
  role              StaffRole
  isActive          Boolean   @default(true)
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  assignedSupportTickets SupportTicket[] @relation("AssignedSupportTickets")
  supportTicketMessages SupportTicketMessage[] @relation("SupportTicketStaffMessages")

  @@index([role])
  @@index([isActive])
  @@map("staff_accounts")
}

model CustomerSupportAccount {
  id                String                        @id @default(uuid())
  name              String
  email             String                        @unique
  password          String
  isActive          Boolean                       @default(true)
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt
  assignedTickets   SupportTicket[]               @relation("CustomerSupportAssignedTickets")
  messages          SupportTicketMessage[]        @relation("SupportTicketSupportMessages")
  notifies          Notify[]
  pushSubscriptions CustomerSupportPushSubscription[]
  emailLogs         CustomerSupportEmailLog[]

  @@index([isActive])
  @@index([lastLoginAt])
  @@map("customer_support_accounts")
}

model CustomerActivity {
  id        String   @id @default(uuid())
  userId    String
  type      String   @default("SYSTEM")
  title     String
  detail    String?
  path      String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("customer_activities")
}

model ChatbotConversation {
  id        String           @id @default(uuid())
  userId    String
  title     String?
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatbotMessage[]

  @@index([userId])
  @@index([userId, updatedAt])
  @@map("chatbot_conversations")
}

model ChatbotMessage {
  id             String              @id @default(uuid())
  conversationId String
  userId         String
  role           ChatbotMessageRole
  content        String
  provider       String?
  metadata       Json?
  createdAt      DateTime            @default(now())
  conversation   ChatbotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([userId, createdAt])
  @@map("chatbot_messages")
}

model Otp {
  id        String     @id @default(uuid())
  userId    String
  otpHash   String
  purpose   OtpPurpose @default(SIGNUP)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PendingSignup {
  id              String   @id @default(uuid())
  name            String
  email           String
  phone           String
  passwordHash    String
  role            Role     @default(CUSTOMER)
  isEmailVerified Boolean  @default(false)
  isPhoneVerified Boolean  @default(false)
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([email, role])
  @@unique([phone, role])
  @@index([email])
  @@index([phone])
  @@index([expiresAt])
  @@map("pending_signups")
}

model EmailOtp {
  id        String   @id @default(uuid())
  email     String
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([expiresAt])
  @@map("email_otps")
}

model PhoneOtp {
  id        String   @id @default(uuid())
  phone     String
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@index([expiresAt])
  @@map("phone_otps")
}

model CustomerProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  avatarUrl      String?
  address        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  avatarPublicId String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Vehicle {
  id                 String    @id @default(uuid())
  userId             String
  brand              String
  model              String
  year               Int
  fuelType           FuelType
  registrationNumber String?
  isDefault          Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  bookings           Booking[]
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CustomerLocation {
  id        String         @id @default(uuid())
  userId    String
  latitude  Float
  longitude Float
  address           String?
  formattedAddress  String?
  placeId           String?
  addressComponents Json?
  source            LocationSource @default(GPS)
  isDefault Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([latitude, longitude])
}

model Garage {
  id                 String                    @id @default(uuid())
  name               String
  description        String?
  phone              String
  whatsappNo         String?
  email              String?
  address            String
  city               String
  area               String
  latitude           Float
  longitude          Float
  placeId            String?
  workingRadiusKm    Int                       @default(15)
  garageType         String?                   @default("MULTI_BRAND")
  supportedBrands    Json?
  isVerified         Boolean                   @default(false)
  isActive           Boolean                   @default(true)
  ratingAvg          Float                     @default(0)
  ratingCount        Int                       @default(0)
  openingTime        String?
  closingTime        String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  ownerId            String?
  applicationId      String?                   @unique
  bookings           Booking[]
  inspectionImages   BookingInspectionImage[]
  owner              User?                     @relation(fields: [ownerId], references: [id])
  broadcasts         GarageBroadcastRequest[]
  images             GarageImage[]
  services           GarageService[]
  videos             GarageVideo[]
  wallet             GarageWallet?
  walletTransactions GarageWalletTransaction[]
  reviews            Review[]
  trackingPoints     BookingTrackingPoint[]

  @@index([ownerId])
  @@index([city])
  @@index([area])
  @@index([latitude, longitude])
}

model GarageImage {
  id          String   @id @default(uuid())
  garageId    String
  imageUrl    String
  publicId    String
  order       Int      @default(0)
  isThumbnail Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  garage      Garage   @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@index([garageId])
  @@index([isThumbnail])
}

model GarageVideo {
  id              String   @id @default(uuid())
  garageId        String
  videoUrl        String
  publicId        String
  order           Int      @default(0)
  durationSeconds Int?
  sizeBytes       Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  garage          Garage   @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@index([garageId])
}

model ServiceCategory {
  id                String    @id @default(uuid())
  name              String    @unique
  description       String?
  thumbnailUrl      String?
  thumbnailPublicId String?
  isActive          Boolean   @default(true)
  isComingSoon      Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  services          Service[]

  @@index([isComingSoon])
}

model Service {
  id           String   @id @default(uuid())
  categoryId   String
  name         String
  description  String?
  isActive     Boolean  @default(true)
  isComingSoon Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  basePrice    Int?
  maxPrice     Int?
  minPrice     Int?
  durationMin  Int?

  bookingItems    BookingService[]
  cityPriceRanges CityServicePriceRange[]
  garageServices  GarageService[]
  category        ServiceCategory         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  media           ServiceMedia[]

  @@index([categoryId])
  @@index([isActive])
  @@index([isComingSoon])
}

model ServiceMedia {
  id              String    @id @default(uuid())
  serviceId       String
  mediaType       MediaType
  url             String
  publicId        String
  order           Int       @default(0)
  isThumbnail     Boolean   @default(false)
  durationSeconds Int?
  sizeBytes       Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  service         Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@index([mediaType])
  @@index([isThumbnail])
}

model GarageService {
  id           String   @id @default(uuid())
  garageId     String
  serviceId    String
  vehicleBrand String   @default("ALL")
  vehicleModel String   @default("ALL")
  price        Int?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  garage       Garage   @relation(fields: [garageId], references: [id], onDelete: Cascade)
  service      Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([garageId, serviceId, vehicleBrand, vehicleModel])
  @@index([garageId])
  @@index([serviceId])
  @@index([vehicleBrand])
  @@index([vehicleModel])
  @@index([isActive])
}

model CityServicePriceRange {
  id           String    @id @default(uuid())
  city         String
  serviceId    String
  vehicleBrand String?
  vehicleModel String?
  fuelType     FuelType?
  minPrice     Int
  maxPrice     Int
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  service      Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([city])
  @@index([serviceId])
  @@index([vehicleBrand])
  @@index([vehicleModel])
  @@index([fuelType])
  @@index([isActive])
}

model City {
  id             String   @id @default(uuid())
  name           String
  normalizedName String   @unique
  state          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive])
  @@index([name])
}

model Booking {
  id                    String                   @id @default(uuid())
  userId                String
  vehicleId             String
  garageId              String?
  bookingCode           String                   @unique
  scheduledDate         DateTime?
  startTime             String?
  endTime               String?
  status                BookingStatus            @default(PENDING_PAYMENT)
  customerNote          String?
  garageNote            String?
  handlingFee           Int                      @default(49)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  acceptedAt            DateTime?
  customerAddress       String?
  customerLatitude      Float?
  customerLongitude     Float?
  expiredAt             DateTime?
  payableAmount         Int                      @default(49)
  requestType           RequestType              @default(NORMAL)
  totalServiceAmount    Int                      @default(0)
  walletAmountUsed      Int                      @default(0)
  totalServiceMaxAmount Int                      @default(0)
  searchExpiresAt       DateTime?
  handoverOtpHash       String?
  handoverOtpExpiresAt  DateTime?
  handoverOtpVerifiedAt DateTime?
  deliveredAt           DateTime?
  customerAcceptedAt    DateTime?
  customerPlaceId       String?
  routeDistanceMeters   Int?
  routeDurationSeconds  Int?
  routePolyline         String?
  routeUpdatedAt        DateTime?
  trackingStartedAt     DateTime?
  trackingEndedAt       DateTime?
  lastGarageLatitude    Float?
  lastGarageLongitude   Float?
  lastGarageHeading     Float?
  lastGarageSpeedKph    Float?
  lastGarageAccuracyM   Float?
  lastGarageLocationAt  DateTime?
  garage                Garage?                  @relation(fields: [garageId], references: [id])
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle               Vehicle                  @relation(fields: [vehicleId], references: [id])
  inspectionImages      BookingInspectionImage[]
  services              BookingService[]
  complaints            Complaint[]
  broadcasts            GarageBroadcastRequest[]
  payment               Payment?
  review                Review?
  trackingPoints        BookingTrackingPoint[]
  adminEvents           AdminBookingEvent[]
  supportTickets        SupportTicket[]

  @@index([userId])
  @@index([garageId])
  @@index([vehicleId])
  @@index([status])
  @@index([requestType])
}

model AdminBookingEvent {
  id         String   @id @default(uuid())
  bookingId  String
  staffId    String
  staffName  String
  action     String
  note       String?
  metadata   Json?
  createdAt  DateTime @default(now())
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@index([staffId, createdAt])
  @@map("admin_booking_events")
}

model BookingInspectionImage {
  id        String            @id @default(uuid())
  bookingId String
  garageId  String
  phase     BookingPhotoPhase
  imageUrl  String
  publicId  String
  order     Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  booking   Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  garage    Garage            @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@unique([bookingId, phase, order])
  @@index([bookingId])
  @@index([garageId])
  @@index([phase])
}

model BookingService {
  id                String   @id @default(uuid())
  bookingId         String
  serviceId         String
  quantity          Int      @default(1)
  estimatedPrice    Int?
  finalPrice        Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  estimatedMinPrice Int?
  estimatedMaxPrice Int?
  booking           Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service           Service  @relation(fields: [serviceId], references: [id])

  @@unique([bookingId, serviceId])
  @@index([bookingId])
  @@index([serviceId])
}

model GarageBroadcastRequest {
  id                 String          @id @default(uuid())
  bookingId          String
  garageId           String
  status             BroadcastStatus @default(SENT)
  sentAt             DateTime        @default(now())
  acceptedAt         DateTime?
  rejectedAt         DateTime?
  expiredAt          DateTime?
  garageResponseNote String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  booking            Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  garage             Garage          @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@unique([bookingId, garageId])
  @@index([bookingId])
  @@index([garageId])
  @@index([status])
}

model BookingTrackingPoint {
  id               String         @id @default(uuid())
  bookingId        String
  garageId         String?
  userId           String?
  source           TrackingSource @default(GARAGE)
  latitude         Float
  longitude        Float
  snappedLatitude  Float?
  snappedLongitude Float?
  roadPlaceId      String?
  heading          Float?
  speedKph         Float?
  accuracyM        Float?
  recordedAt       DateTime       @default(now())
  createdAt        DateTime       @default(now())
  booking          Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  garage           Garage?        @relation(fields: [garageId], references: [id], onDelete: SetNull)
  user             User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([bookingId, recordedAt])
  @@index([garageId, recordedAt])
  @@index([userId, recordedAt])
  @@map("booking_tracking_points")
}

model Payment {
  id                       String        @id @default(uuid())
  bookingId                String        @unique
  amount                   Int
  currency                 String        @default("INR")
  status                   PaymentStatus @default(CREATED)
  cashfreeOrderId          String?       @unique
  cashfreePaymentId        String?       @unique
  cashfreePaymentSessionId String?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  upiAmountPaid            Int           @default(0)
  walletAmountUsed         Int           @default(0)
  booking                  Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Wallet {
  id           String              @id @default(uuid())
  userId       String              @unique
  type         WalletType          @default(CUSTOMER)
  balance      Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id                String                  @id @default(uuid())
  walletId          String
  userId            String
  type              WalletTransactionType
  status            WalletTransactionStatus @default(SUCCESS)
  amount            Int
  balanceAfter      Int?
  description       String?
  cashfreeOrderId   String?
  cashfreePaymentId String?
  createdAt         DateTime                @default(now())
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet            Wallet                  @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([userId])
  @@index([type])
  @@index([status])
}

model GarageWallet {
  id           String                    @id @default(uuid())
  garageId     String                    @unique
  balance      Int                       @default(0)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  garage       Garage                    @relation(fields: [garageId], references: [id], onDelete: Cascade)
  transactions GarageWalletTransaction[]
}

model GarageWalletTransaction {
  id                String                  @id @default(uuid())
  garageWalletId    String
  garageId          String
  type              WalletTransactionType
  status            WalletTransactionStatus @default(SUCCESS)
  amount            Int
  balanceAfter      Int?
  description       String?
  cashfreeOrderId   String?
  cashfreePaymentId String?
  createdAt         DateTime                @default(now())
  garage            Garage                  @relation(fields: [garageId], references: [id], onDelete: Cascade)
  garageWallet      GarageWallet            @relation(fields: [garageWalletId], references: [id], onDelete: Cascade)

  @@index([garageWalletId])
  @@index([garageId])
  @@index([type])
  @@index([status])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  garageId  String
  bookingId String   @unique
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  garage    Garage   @relation(fields: [garageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([garageId])
}

model VehicleBrand {
  id        String         @id @default(uuid())
  name      String         @unique
  logoUrl   String?
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  models    VehicleModel[]
}

model VehicleModel {
  id        String       @id @default(uuid())
  brandId   String
  name      String
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  brand     VehicleBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, name])
  @@index([brandId])
}

model SupportTicket {
  id                String                    @id @default(uuid())
  ticketCode        String                    @unique
  userId            String
  bookingId         String?
  type              SupportTicketType         @default(SUPPORT)
  category          SupportTicketCategory     @default(GENERAL)
  subject           String
  description       String
  priority          SupportTicketPriority     @default(NORMAL)
  status            SupportTicketStatus       @default(OPEN)
  assignedToId      String?
  supportAssigneeId String?
  claimedAt         DateTime?
  resolutionOutcome DisputeResolutionOutcome?
  resolutionNote    String?
  refundAmount      Int?
  resolvedAt        DateTime?
  lastMessageAt     DateTime                  @default(now())
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking           Booking?                  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  assignedTo        StaffAccount?             @relation("AssignedSupportTickets", fields: [assignedToId], references: [id], onDelete: SetNull)
  supportAssignee   CustomerSupportAccount?    @relation("CustomerSupportAssignedTickets", fields: [supportAssigneeId], references: [id], onDelete: SetNull)
  messages          SupportTicketMessage[]
  attachments       SupportTicketAttachment[]

  @@index([userId, updatedAt])
  @@index([bookingId])
  @@index([assignedToId, status])
  @@index([supportAssigneeId, status])
  @@index([type, status, priority])
  @@index([lastMessageAt])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id            String                   @id @default(uuid())
  ticketId      String
  authorType    SupportMessageAuthorType
  authorUserId  String?
  authorStaffId String?
  authorSupportId String?
  authorName    String
  body          String
  isInternal    Boolean                  @default(false)
  createdAt     DateTime                 @default(now())
  ticket        SupportTicket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorUser    User?                    @relation("SupportTicketUserMessages", fields: [authorUserId], references: [id], onDelete: SetNull)
  authorStaff   StaffAccount?            @relation("SupportTicketStaffMessages", fields: [authorStaffId], references: [id], onDelete: SetNull)
  authorSupport CustomerSupportAccount?  @relation("SupportTicketSupportMessages", fields: [authorSupportId], references: [id], onDelete: SetNull)
  attachments   SupportTicketAttachment[]

  @@index([ticketId, createdAt])
  @@index([authorUserId])
  @@index([authorStaffId])
  @@index([authorSupportId])
  @@map("support_ticket_messages")
}

model SupportTicketAttachment {
  id        String                @id @default(uuid())
  ticketId  String
  messageId String?
  imageUrl  String
  publicId  String
  order     Int                   @default(0)
  createdAt DateTime              @default(now())
  ticket    SupportTicket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message   SupportTicketMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([messageId])
  @@map("support_ticket_attachments")
}

model Notify {
  id               String                 @id @default(uuid())
  supportAccountId String
  title            String
  message          String
  type             String                 @default("SYSTEM")
  link             String?
  isRead           Boolean                @default(false)
  metadata         Json?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  supportAccount   CustomerSupportAccount @relation(fields: [supportAccountId], references: [id], onDelete: Cascade)

  @@index([supportAccountId, isRead, createdAt])
  @@index([type, createdAt])
  @@map("notify")
}

model CustomerSupportPushSubscription {
  id               String                 @id @default(uuid())
  supportAccountId String
  endpoint         String                 @unique
  p256dh           String
  auth             String
  userAgent        String?
  deviceName       String?
  lastUsedAt       DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  supportAccount   CustomerSupportAccount @relation(fields: [supportAccountId], references: [id], onDelete: Cascade)

  @@index([supportAccountId])
  @@map("customer_support_push_subscriptions")
}

model CustomerSupportEmailLog {
  id               String                 @id @default(uuid())
  supportAccountId String
  userId           String?
  recipientEmail   String
  recipientName    String?
  subject          String
  status           String                 @default("SENT")
  providerMessageId String?
  errorMessage     String?
  createdAt        DateTime               @default(now())
  supportAccount   CustomerSupportAccount @relation(fields: [supportAccountId], references: [id], onDelete: Cascade)

  @@index([supportAccountId, createdAt])
  @@index([recipientEmail])
  @@map("customer_support_email_logs")
}

model Complaint {
  id          String           @id @default(uuid())
  userId      String
  bookingId   String?
  title       String
  description String
  status      ComplaintStatus  @default(OPEN)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  adminReply  String?
  resolvedAt  DateTime?
  booking     Booking?         @relation(fields: [bookingId], references: [id])
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  images      ComplaintImage[]

  @@index([userId])
  @@index([bookingId])
  @@index([status])
}

model ComplaintImage {
  id          String    @id @default(uuid())
  complaintId String
  imageUrl    String
  publicId    String
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String?
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  link      String?
  metadata  Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}


model PushSubscription {
  id         String   @id @default(uuid())
  userId     String
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  deviceName String?
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model GarageApplication {
  id               String                   @id @default(uuid())
  ownerName        String
  email            String
  phone            String
  garageName       String
  description      String?
  address          String
  city             String
  area             String
  latitude         Float?
  longitude        Float?
  placeId          String?
  workingRadiusKm  Int                      @default(15)
  status           GarageApplicationStatus  @default(PENDING)
  adminNote        String?
  reviewedAt       DateTime?
  approvedGarageId String?                  @unique
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  images           GarageApplicationImage[]

  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([createdAt])
}

model GarageApplicationImage {
  id            String            @id @default(uuid())
  applicationId String
  imageUrl      String
  publicId      String
  order         Int               @default(0)
  isThumbnail   Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  application   GarageApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([isThumbnail])
}

model SystemIssue {
  id              String               @id @default(uuid())
  fingerprint     String               @unique
  title           String
  message         String
  stack           String?
  source          SystemIssueSource
  severity        SystemIssueSeverity  @default(ERROR)
  status          SystemIssueStatus    @default(OPEN)
  actorType       SystemIssueActorType @default(PUBLIC)
  userId          String?
  garageId        String?
  route           String?
  method          String?
  endpoint        String?
  httpStatus      Int?
  errorName       String?
  component       String?
  environment     String?
  release         String?
  userAgent       String?
  ipAddress       String?
  metadata        Json?
  occurrenceCount Int                  @default(1)
  firstSeenAt     DateTime             @default(now())
  lastSeenAt      DateTime             @default(now())
  resolvedAt      DateTime?
  resolvedById    String?
  resolutionNote  String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([status, lastSeenAt])
  @@index([severity, lastSeenAt])
  @@index([actorType, lastSeenAt])
  @@index([source, lastSeenAt])
}

