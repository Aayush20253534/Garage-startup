generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                 @id @default(uuid())
  name                  String
  email                 String
  phone                 String?
  password              String
  role                  Role                   @default(CUSTOMER)
  isEmailVerified       Boolean                @default(false)
  isPhoneVerified       Boolean                @default(false)
  isOnboarded           Boolean                @default(false)
  isActive              Boolean                @default(true)
  passwordChangedAt     DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  authProvider          String                 @default("PASSWORD")
  firebaseUid           String?                @unique
  termsAcceptedAt       DateTime?
  privacyAcceptedAt     DateTime?
  bookings              Booking[]
  complaints            Complaint[]
  locations             CustomerLocation[]
  customerProfile       CustomerProfile?
  notifications         Notification[]
  pushSubscriptions     PushSubscription[]
  sessions              UserSession[]
  otps                  Otp[]
  reviews               Review[]
  vehicles              Vehicle[]
  wallet                Wallet?
  walletTransactions    WalletTransaction[]
  chatbotConversations  ChatbotConversation[]
  chatbotMessages       ChatbotMessage[]
  customerActivities    CustomerActivity[]
  trackingPoints        BookingTrackingPoint[]
  supportTickets        SupportTicket[]
  supportTicketMessages SupportTicketMessage[] @relation("SupportTicketUserMessages")

  @@unique([email, role])
  @@unique([phone, role])
  @@index([email])
  @@index([phone])
}

model GarageOwner {
  id                String                   @id @default(uuid())
  name              String
  email             String?                  @unique
  phone             String                   @unique
  password          String
  role              Role                     @default(GARAGE_OWNER)
  isEmailVerified   Boolean                  @default(true)
  isPhoneVerified   Boolean                  @default(false)
  isOnboarded       Boolean                  @default(true)
  isActive          Boolean                  @default(true)
  passwordChangedAt DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  garages           Garage[]
  sessions          GarageOwnerSession[]
  otps              GarageOwnerOtp[]
  notifications     Notification[]
  pushSubscriptions GaragePushSubscription[]
  trackingPoints    BookingTrackingPoint[]

  @@index([isActive])
  @@map("garage_owners")
}

model GarageController {
  id                String                       @id @default(uuid())
  garageId          String
  name              String
  email             String                       @unique
  phone             String                       @unique
  password          String
  role              Role                         @default(GARAGE_CONTROLLER)
  isActive          Boolean                      @default(true)
  availability      GarageControllerAvailability @default(AVAILABLE)
  passwordChangedAt DateTime?
  lastLoginAt       DateTime?
  lastActiveAt      DateTime?
  createdByType     String
  createdById       String
  deletedAt         DateTime?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  garage            Garage                       @relation(fields: [garageId], references: [id], onDelete: Cascade)
  sessions          GarageControllerSession[]
  otps              GarageControllerOtp[]
  bookings          Booking[]
  notifications     Notification[]
  dispatches        GarageControllerDispatch[]
  trackingPoints    BookingTrackingPoint[]

  @@index([garageId, deletedAt, isActive, availability])
  @@index([garageId, lastActiveAt])
  @@map("garage_controllers")
}

model GarageControllerSession {
  id                 String           @id @default(uuid())
  garageControllerId String
  userAgent          String?
  deviceId           String?
  lastSeenAt         DateTime         @default(now())
  expiresAt          DateTime
  revokedAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  garageController   GarageController @relation(fields: [garageControllerId], references: [id], onDelete: Cascade)

  @@index([garageControllerId, expiresAt])
  @@index([garageControllerId, deviceId])
  @@index([lastSeenAt])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("garage_controller_sessions")
}

model GarageControllerOtp {
  id                 String           @id @default(uuid())
  garageControllerId String
  otpHash            String
  purpose            OtpPurpose       @default(RESET_PASSWORD)
  expiresAt          DateTime
  usedAt             DateTime?
  attempts           Int              @default(0)
  createdAt          DateTime         @default(now())
  garageController   GarageController @relation(fields: [garageControllerId], references: [id], onDelete: Cascade)

  @@unique([garageControllerId, purpose])
  @@index([garageControllerId])
  @@map("garage_controller_otps")
}

model GarageOwnerSession {
  id            String      @id @default(uuid())
  garageOwnerId String
  userAgent     String?
  deviceId      String?
  lastSeenAt    DateTime    @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  garageOwner   GarageOwner @relation(fields: [garageOwnerId], references: [id], onDelete: Cascade)

  @@index([garageOwnerId, expiresAt])
  @@index([garageOwnerId, deviceId])
  @@index([lastSeenAt])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("garage_owner_sessions")
}

model GarageOwnerOtp {
  id            String      @id @default(uuid())
  garageOwnerId String
  otpHash       String
  purpose       OtpPurpose
  expiresAt     DateTime
  usedAt        DateTime?
  attempts      Int         @default(0)
  createdAt     DateTime    @default(now())
  garageOwner   GarageOwner @relation(fields: [garageOwnerId], references: [id], onDelete: Cascade)

  @@unique([garageOwnerId, purpose])
  @@index([garageOwnerId])
  @@map("garage_owner_otps")
}

model UserSession {
  id         String    @id @default(uuid())
  userId     String
  userAgent  String?
  deviceId   String?
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, deviceId])
  @@index([lastSeenAt])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("user_sessions")
}

model StaffAccount {
  id                     String                       @id @default(uuid())
  name                   String
  loginId                String                       @unique
  email                  String?                      @unique
  phone                  String?                      @unique
  password               String
  role                   StaffRole
  isActive               Boolean                      @default(true)
  lastLoginAt            DateTime?
  passwordChangedAt      DateTime?
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  sessions               StaffSession[]
  passwordResetChallenge StaffPasswordResetChallenge?
  assignedSupportTickets SupportTicket[]              @relation("AssignedSupportTickets")
  supportTicketMessages  SupportTicketMessage[]       @relation("SupportTicketStaffMessages")
  priceRangeSubmissions  PriceRangeSubmission[]       @relation("PriceRangeSubmissionSubmitter")
  priceRangeReviews      PriceRangeSubmission[]       @relation("PriceRangeSubmissionReviewer")
  createdCityDiscounts  CityPriceDiscount[]           @relation("CityPriceDiscountCreatedBy")
  updatedCityDiscounts  CityPriceDiscount[]           @relation("CityPriceDiscountUpdatedBy")
  createdById            String?
  createdByName          String?

  @@index([role])
  @@index([isActive])
  @@map("staff_accounts")
}

model CustomerSupportAccount {
  id                String                            @id @default(uuid())
  name              String
  email             String                            @unique
  password          String
  isActive          Boolean                           @default(true)
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  createdAt         DateTime                          @default(now())
  updatedAt         DateTime                          @updatedAt
  assignedTickets   SupportTicket[]                   @relation("CustomerSupportAssignedTickets")
  messages          SupportTicketMessage[]            @relation("SupportTicketSupportMessages")
  notifies          Notify[]
  pushSubscriptions CustomerSupportPushSubscription[]
  sessions          CustomerSupportSession[]
  emailLogs         CustomerSupportEmailLog[]

  @@index([isActive])
  @@index([lastLoginAt])
  @@map("customer_support_accounts")
}

model StaffSession {
  id             String       @id @default(uuid())
  staffAccountId String
  userAgent      String?
  deviceId       String?
  lastSeenAt     DateTime     @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  staffAccount   StaffAccount @relation(fields: [staffAccountId], references: [id], onDelete: Cascade)

  @@index([staffAccountId, expiresAt])
  @@index([staffAccountId, deviceId])
  @@index([lastSeenAt])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("staff_sessions")
}

model CustomerSupportSession {
  id               String                 @id @default(uuid())
  supportAccountId String
  userAgent        String?
  deviceId         String?
  lastSeenAt       DateTime               @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  supportAccount   CustomerSupportAccount @relation(fields: [supportAccountId], references: [id], onDelete: Cascade)

  @@index([supportAccountId, expiresAt])
  @@index([supportAccountId, deviceId])
  @@index([lastSeenAt])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("customer_support_sessions")
}

model StaffLoginChallenge {
  id            String    @id @default(uuid())
  accountId     String
  accountType   String
  role          String
  deliveryEmail String
  otpHash       String
  attempts      Int       @default(0)
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([accountId, accountType])
  @@index([expiresAt])
  @@map("staff_login_challenges")
}

model StaffPasswordResetChallenge {
  id             String       @id @default(uuid())
  staffAccountId String       @unique
  otpHash        String
  attempts       Int          @default(0)
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  staffAccount   StaffAccount @relation(fields: [staffAccountId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("staff_password_reset_challenges")
}

model CustomerActivity {
  id        String   @id @default(uuid())
  userId    String
  type      String   @default("SYSTEM")
  title     String
  detail    String?
  path      String?
  metadata  Json?
  eventKey  String?  @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("customer_activities")
}

model ChatbotConversation {
  id        String           @id @default(uuid())
  userId    String
  title     String?
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatbotMessage[]

  @@index([userId])
  @@index([userId, updatedAt])
  @@map("chatbot_conversations")
}

model ChatbotMessage {
  id             String              @id @default(uuid())
  conversationId String
  userId         String
  role           ChatbotMessageRole
  content        String
  provider       String?
  metadata       Json?
  createdAt      DateTime            @default(now())
  conversation   ChatbotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([userId, createdAt])
  @@map("chatbot_messages")
}

model Otp {
  id        String     @id @default(uuid())
  userId    String
  otpHash   String
  purpose   OtpPurpose @default(SIGNUP)
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int        @default(0)
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, purpose])
  @@index([userId])
}

model PendingSignup {
  id                String   @id @default(uuid())
  name              String
  email             String
  phone             String
  passwordHash      String
  role              Role     @default(CUSTOMER)
  isEmailVerified   Boolean  @default(false)
  isPhoneVerified   Boolean  @default(false)
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  termsAcceptedAt   DateTime
  privacyAcceptedAt DateTime

  @@unique([email, role])
  @@unique([phone, role])
  @@index([email])
  @@index([phone])
  @@index([expiresAt])
  @@map("pending_signups")
}

model EmailOtp {
  id        String   @id @default(uuid())
  email     String
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email])
  @@index([expiresAt])
  @@map("email_otps")
}

model PhoneOtp {
  id        String   @id @default(uuid())
  phone     String
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([phone])
  @@index([expiresAt])
  @@map("phone_otps")
}

model CustomerProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  avatarUrl      String?
  address        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  avatarPublicId String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Vehicle {
  id                 String    @id @default(uuid())
  userId             String
  brand              String
  model              String
  year               Int
  fuelType           FuelType
  registrationNumber String?
  isDefault          Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  bookings           Booking[]
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CustomerLocation {
  id                String         @id @default(uuid())
  userId            String
  latitude          Float
  longitude         Float
  address           String?
  formattedAddress  String?
  placeId           String?
  addressComponents Json?
  source            LocationSource @default(GPS)
  isDefault         Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([latitude, longitude])
}

model Garage {
  id                    String                    @id @default(uuid())
  name                  String
  description           String?
  phone                 String
  whatsappNo            String?
  email                 String?
  address               String
  city                  String
  area                  String
  latitude              Float
  longitude             Float
  placeId               String?
  workingRadiusKm       Int                       @default(15)
  fulfillmentMode       GarageFulfillmentMode     @default(BOTH)
  garageType            String?                   @default("MULTI_BRAND")
  supportedBrands       Json?
  excludedServiceBrands Json                      @default("[]")
  isVerified            Boolean                   @default(false)
  isActive              Boolean                   @default(true)
  ratingAvg             Float                     @default(0)
  ratingCount           Int                       @default(0)
  openingTime           String?
  closingTime           String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  ownerId               String?
  controllerLimit       Int                       @default(3)
  applicationId         String?                   @unique
  bookings              Booking[]
  inspectionImages      BookingInspectionImage[]
  owner                 GarageOwner?              @relation(fields: [ownerId], references: [id])
  controllers           GarageController[]
  broadcasts            GarageBroadcastRequest[]
  images                GarageImage[]
  services              GarageService[]
  videos                GarageVideo[]
  wallet                GarageWallet?
  walletTransactions    GarageWalletTransaction[]
  reviews               Review[]
  trackingPoints        BookingTrackingPoint[]
  availabilityRules     ServiceAvailabilityRule[]

  operationalStatus     GarageOperationalStatus @default(ACTIVE)
  suspensionReason      String?
  suspendedAt           DateTime?
  suspendedUntil        DateTime?

  @@index([ownerId])
  @@index([city])
  @@index([area])
  @@index([latitude, longitude])
  @@index([operationalStatus, city])
  @@index([operationalStatus, suspendedUntil])
  @@index([fulfillmentMode])
}

model GarageImage {
  id          String   @id @default(uuid())
  garageId    String
  imageUrl    String
  publicId    String
  order       Int      @default(0)
  isThumbnail Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  garage      Garage   @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@index([garageId])
  @@index([isThumbnail])
}

model GarageVideo {
  id              String   @id @default(uuid())
  garageId        String
  videoUrl        String
  publicId        String
  order           Int      @default(0)
  durationSeconds Int?
  sizeBytes       Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  garage          Garage   @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@index([garageId])
}

model ServiceCategory {
  id                String                    @id @default(uuid())
  name              String                    @unique
  description       String?
  thumbnailUrl      String?
  thumbnailPublicId String?
  isActive          Boolean                   @default(true)
  isComingSoon      Boolean                   @default(false)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  services          Service[]
  cityRestrictions  CategoryCityRestriction[]

  @@index([isComingSoon])
}

model Service {
  id           String   @id @default(uuid())
  categoryId   String
  name         String
  description  String?
  isActive     Boolean  @default(true)
  isComingSoon Boolean  @default(false)
  isPopular    Boolean  @default(false)
  popularOrder Int?
  fulfillmentType ServiceFulfillmentMode @default(BOTH)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  durationMin  Int?

  bookingItems     BookingService[]
  cityPriceRanges  CityServicePriceRange[]
  priceSubmissions PriceRangeSubmission[]
  garageServices   GarageService[]
  category         ServiceCategory          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  media            ServiceMedia[]
  cityRestrictions ServiceCityRestriction[]
  availabilityRules ServiceAvailabilityRule[]
  priceSchedules   PriceRangeSchedule[]

  @@index([categoryId])
  @@index([isActive])
  @@index([isComingSoon])
  @@index([isPopular, popularOrder])
  @@index([fulfillmentType])
}

model ServiceMedia {
  id              String    @id @default(uuid())
  serviceId       String
  mediaType       MediaType
  url             String
  publicId        String
  order           Int       @default(0)
  isThumbnail     Boolean   @default(false)
  durationSeconds Int?
  sizeBytes       Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  service         Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@index([mediaType])
  @@index([isThumbnail])
}

model GarageService {
  id           String   @id @default(uuid())
  garageId     String
  serviceId    String
  vehicleBrand String   @default("ALL")
  vehicleModel String   @default("ALL")
  isExcluded   Boolean  @default(false)
  price        Int?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  garage       Garage   @relation(fields: [garageId], references: [id], onDelete: Cascade)
  service      Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([garageId, serviceId, vehicleBrand, vehicleModel])
  @@index([garageId])
  @@index([serviceId])
  @@index([vehicleBrand])
  @@index([vehicleModel])
  @@index([isExcluded])
  @@index([isActive])
}

model CityServicePriceRange {
  id           String                 @id @default(uuid())
  scopeKey     String                 @unique
  city         String
  serviceId    String
  vehicleBrand String?
  vehicleModel String?
  fuelType     FuelType?
  minPrice     Int
  maxPrice     Int
  isActive     Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  service      Service                @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  submissions  PriceRangeSubmission[]

  @@index([city])
  @@index([serviceId])
  @@index([vehicleBrand])
  @@index([vehicleModel])
  @@index([fuelType])
  @@index([isActive])
}

model PriceRangeSubmission {
  id                   String                     @id @default(uuid())
  city                 String
  serviceId            String
  vehicleBrand         String?
  vehicleModel         String?
  fuelType             FuelType?
  minPrice             Int
  maxPrice             Int
  isActive             Boolean                    @default(true)
  status               PriceRangeSubmissionStatus @default(PENDING)
  submittedById        String?
  reviewedById         String?
  reviewedAt           DateTime?
  rejectionReason      String?
  approvedPriceRangeId String?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  service              Service                    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  submittedBy          StaffAccount?              @relation("PriceRangeSubmissionSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedBy           StaffAccount?              @relation("PriceRangeSubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  approvedPriceRange   CityServicePriceRange?     @relation(fields: [approvedPriceRangeId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([submittedById, createdAt])
  @@index([reviewedById])
  @@index([serviceId])
  @@index([city])
  @@index([approvedPriceRangeId])
  @@map("price_range_submissions")
}

model City {
  id                   String                    @id @default(uuid())
  name                 String
  normalizedName       String                    @unique
  state                String?
  isActive             Boolean                   @default(true)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  serviceRestrictions  ServiceCityRestriction[]
  categoryRestrictions CategoryCityRestriction[]
  availabilityRules     ServiceAvailabilityRule[]
  priceDiscount         CityPriceDiscount?

  @@index([isActive])
  @@index([name])
}


model CityPriceDiscount {
  id              String        @id @default(uuid())
  cityId          String        @unique
  discountPercent Int
  isActive        Boolean       @default(true)
  createdById     String?
  updatedById     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  city            City          @relation(fields: [cityId], references: [id], onDelete: Cascade)
  createdBy       StaffAccount? @relation("CityPriceDiscountCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       StaffAccount? @relation("CityPriceDiscountUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([createdById])
  @@index([updatedById])
  @@map("city_price_discounts")
}

model ServiceCityRestriction {
  id        String   @id @default(uuid())
  serviceId String
  cityId    String
  createdAt DateTime @default(now())
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([serviceId, cityId])
  @@index([serviceId])
  @@index([cityId])
  @@map("service_city_restrictions")
}

model CategoryCityRestriction {
  id         String          @id @default(uuid())
  categoryId String
  cityId     String
  createdAt  DateTime        @default(now())
  category   ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  city       City            @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([categoryId, cityId])
  @@index([categoryId])
  @@index([cityId])
  @@map("service_category_city_restrictions")
}

model Booking {
  id                    String                   @id @default(uuid())
  userId                String
  vehicleId             String
  garageId              String?
  garageControllerId    String?
  bookingCode           String                   @unique
  scheduledDate         DateTime?
  startTime             String?
  endTime               String?
  status                BookingStatus            @default(PENDING_PAYMENT)
  customerNote          String?
  garageNote            String?
  handlingFee           Int                      @default(49)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  acceptedAt            DateTime?
  customerAddress       String?
  customerLatitude      Float?
  customerLongitude     Float?
  expiredAt             DateTime?
  payableAmount         Int                      @default(49)
  requestType           RequestType              @default(NORMAL)
  fulfillmentType       ServiceFulfillmentType    @default(PICKUP_DELIVERY)
  totalServiceAmount    Int                      @default(0)
  walletAmountUsed      Int                      @default(0)
  totalServiceMaxAmount Int                      @default(0)
  searchExpiresAt       DateTime?
  garageSearchRound     Int                      @default(0)
  garageSearchCycle     Int                      @default(1)
  searchRadiusKm        Int?
  handoverOtpHash       String?
  handoverOtpExpiresAt  DateTime?
  handoverOtpVerifiedAt DateTime?
  handoverOtpAttempts   Int                      @default(0)
  handoverOtpClaimedAt  DateTime?
  deliveredAt           DateTime?
  customerAcceptedAt    DateTime?
  customerPlaceId       String?
  routeDistanceMeters   Int?
  routeDurationSeconds  Int?
  routePolyline         String?
  routeUpdatedAt        DateTime?
  trackingStartedAt     DateTime?
  trackingEndedAt       DateTime?
