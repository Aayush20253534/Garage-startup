# =========================================================
# Rovauto backend — local development
# Copy this file to server/.env and replace placeholders.
# Never commit server/.env.
# =========================================================

# ---------- Core application ----------
NODE_ENV=development
PORT=5000
APP_TIME_ZONE=Asia/Kolkata

# Local frontend and backend URLs
CLIENT_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080
PUBLIC_API_URL=http://localhost:5000
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Use a long random value (at least 32 characters).
JWT_SECRET=replace-with-a-long-random-local-secret

# ---------- PostgreSQL / Prisma ----------
# For a local PostgreSQL database named "rovauto".
# Change username, password, host, port, or database as needed.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rovauto?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/rovauto?schema=public"

# ---------- Local OTP behaviour ----------
# In development, non-email mode prints email OTPs in the server terminal.
EMAIL_OTP_DELIVERY=console

# In development, this prints SMS OTPs in the server terminal.
SMS_PROVIDER=console

# Avoid automatic endpoint probing while developing locally.
SYSTEM_ISSUE_AUTO_RESOLVE_ENABLED=false

# ---------- Optional: seed local admin ----------
# Used only by: npm run seed:admin
ADMIN_LOGIN_ID=admin
ADMIN_PASSWORD=replace-with-a-strong-local-password
ADMIN_NAME=Rovauto Admin
ADMIN_2FA_EMAIL=admin@example.com

# ---------- Optional: Redis ----------
# The server can start without Redis, but /health/ready reports unavailable.
# REDIS_URL=redis://localhost:6379

# ---------- Optional: real email through Resend ----------
# Set EMAIL_OTP_DELIVERY=email when enabling this section.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Rovauto <noreply@your-domain.com>
# EMAIL_FROM=Rovauto <noreply@your-domain.com>
# NEW_USER_NOTIFICATION_EMAIL=rovauto.official@gmail.com
# CONTACT_INBOX=support@your-domain.com

# ---------- Optional: Firebase authentication ----------
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---------- Optional: Cloudinary uploads ----------
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Upload up to four inspection assets to Cloudinary at once after the browser
# body reaches the API. Allowed runtime range is 1-6.
# INSPECTION_UPLOAD_CONCURRENCY=4


# ---------- Vehicle registration verification (Way2API RC) ----------
# New customer accounts created after this feature is deployed must verify the
# registration number before saving a vehicle. Existing customers remain
# backward-compatible and may add/verify it later from My Vehicles.
VEHICLE_REGISTRATION_VERIFICATION_ENABLED=true
# Create a Way2API account and copy the API key from its dashboard. Keep this
# server-side only; the browser never receives or calls Way2API directly.
WAY2API_API_KEY=
WAY2API_RC_URL=https://app.way2api.com/api/v1/rc/verify
WAY2API_RC_TIMEOUT_MS=12000

# ---------- Optional: Google Maps ----------
# Use a server-restricted key for GOOGLE_MAPS_API_KEY.
# Use a browser/domain-restricted key for GOOGLE_MAPS_BROWSER_KEY.
# GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_BROWSER_KEY=
# GOOGLE_MAPS_MAP_ID=
# GOOGLE_MAPS_REGION_CODES=in

# ---------- Optional: Groq chatbot/address correction ----------
# GROQ_API_KEY=

# ---------- Optional: Cashfree sandbox ----------
# Cashfree return and webhook URLs must be publicly reachable HTTPS URLs.
# Use a tunnel such as an HTTPS development URL when testing locally.
# CASHFREE_ENV=sandbox
# CASHFREE_APP_ID=
# CASHFREE_SECRET_KEY=
# CASHFREE_WEBHOOK_SECRET=
# CASHFREE_WEBHOOK_SIGNATURE_REQUIRED=true
# CASHFREE_NOTIFY_URL=https://your-public-backend.example/api/v1/webhooks/cashfree

# ---------- Optional: Fast2SMS instead of terminal OTP ----------
# SMS_PROVIDER=fast2sms_quick
# FAST2SMS_API_KEY=

# ---------- Optional: WhatsApp Cloud API ----------
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# Template names/languages are safe defaults; credentials above remain secret.
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_GARAGE_REQUEST_TEMPLATE=garage_booking_request
WHATSAPP_GARAGE_ACCEPTED_DETAILS_TEMPLATE=garage_booking_accepted_details
WHATSAPP_CUSTOMER_BOOKING_CONFIRMED_TEMPLATE=customer_booking_confirmed
WHATSAPP_CUSTOMER_BOOKING_CONFIRMED_LANGUAGE=en
WHATSAPP_WORKER_TASK_TEMPLATE=garage_worker_task_assignment
WHATSAPP_WORKER_TASK_TEMPLATE_LANGUAGE=en

# ---------- Optional: Web Push ----------
# Generate keys with: npm run push:generate-vapid-keys
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=

# First-booking acquisition verification
FIRST_BOOKING_FREE_MAX_ESTIMATE=5000
FIRST_BOOKING_LEAD_ESCALATION_MINUTES=2
FIRST_BOOKING_LEAD_WORKER_INTERVAL_MS=30000
FIRST_BOOKING_VERIFICATION_ADMIN_EMAIL=rovauto.official@gmail.com
