# Rovauto frontend - local development
# Copy this file to client/.env

# Required: local backend API root
VITE_API_URL=http://localhost:5000/api/v1

# Recommended locally: prevents browser errors from being submitted as system issues
VITE_ERROR_REPORTING_ENABLED=false

# Optional: required only when testing Google Sign-In locally
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Google Maps does not need frontend variables by default.
# The frontend fetches the browser key and Map ID from GET /api/v1/maps/config,
# using GOOGLE_MAPS_BROWSER_KEY and GOOGLE_MAPS_MAP_ID from server/.env.
