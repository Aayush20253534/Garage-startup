{
  "id": "/support-app",
  "name": "Rovauto Support",
  "short_name": "Rovauto Support",
  "description": "Dedicated customer support workspace for Rovauto tickets, disputes and alerts.",
  "start_url": "/support?pwa=support",
  "scope": "/support",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait-primary",
  "background_color": "#ffffff",
  "theme_color": "#111111",
  "categories": [
    "business",
    "productivity"
  ],
  "icons": [
    {
      "src": "/support-brand-v4-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/support-brand-v4-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/support-brand-v4-icon-1024.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/support-brand-v4-icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/support-brand-v4-icon-maskable-1024.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Support dashboard",
      "short_name": "Dashboard",
      "url": "/support",
      "icons": [
        {
          "src": "/support-brand-v4-icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Tickets and disputes",
      "short_name": "Tickets",
      "url": "/support/tickets",
      "icons": [
        {
          "src": "/support-brand-v4-icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Received alerts",
      "short_name": "Alerts",
      "url": "/support/notify",
      "icons": [
        {
          "src": "/support-brand-v4-icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "lang": "en-IN",
  "dir": "ltr",
  "prefer_related_applications": false
}
