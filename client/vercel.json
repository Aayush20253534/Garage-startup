{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' https://sdk.cashfree.com https://maps.googleapis.com https://maps.gstatic.com https://accounts.google.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://res.cloudinary.com https://*.cloudinary.com https://api.rovauto.com https://rovauto.onrender.com https://maps.gstatic.com https://maps.googleapis.com https://*.googleusercontent.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://*.cashfree.com https://api.cashfree.com https://api.rovauto.com https://rovauto.onrender.com https://maps.googleapis.com https://places.googleapis.com https://routes.googleapis.com https://roads.googleapis.com https://addressvalidation.googleapis.com https://*.googleapis.com https://*.firebaseapp.com https://*.firebaseio.com; worker-src 'self'; manifest-src 'self'; frame-src 'self' https://*.cashfree.com https://accounts.google.com https://*.firebaseapp.com;"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), display-capture=(self), payment=(self \"https://*.cashfree.com\"), usb=(), geolocation=(self)"
        }
      ]
    },
    {
      "source": "/api/v1/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/support-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/support"
        }
      ]
    },
    {
      "source": "/admin-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/admin"
        }
      ]
    },
    {
      "source": "/intern-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/intern"
        }
      ]
    },
    {
      "source": "/garage-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/garage"
        }
      ]
    },
    {
      "source": "/pwa-install-bootstrap.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/offline.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/((?!api/v1/|assets/).*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/(site|support|admin|intern|garage).webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://rovauto.onrender.com/api/v1/:path*"
    },
    {
      "source": "/support",
      "destination": "/support.html"
    },
    {
      "source": "/support/:path*",
      "destination": "/support.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin.html"
    },
    {
      "source": "/intern",
      "destination": "/intern.html"
    },
    {
      "source": "/intern/:path*",
      "destination": "/intern.html"
    },
    {
      "source": "/garage",
      "destination": "/garage.html"
    },
    {
      "source": "/garage/:path*",
      "destination": "/garage.html"
    },
    {
      "source": "/((?!api/v1/|assets/|support(?:/|$)|admin(?:/|$)|intern(?:/|$)|garage(?:/|$)|sw\\.js$|support-sw\\.js$|admin-sw\\.js$|intern-sw\\.js$|garage-sw\\.js$|pwa-install-bootstrap\\.js$|offline\\.html$|site\\.webmanifest$|support\\.webmanifest$|admin\\.webmanifest$|intern\\.webmanifest$|garage\\.webmanifest$|support-icon-(?:192|512|1024)\\.png$|support-icon-maskable-(?:512|1024)\\.png$|support-apple-touch-icon\\.png$|support-notification-badge-96\\.png$|admin-icon-(?:192|512|1024)\\.png$|admin-icon-maskable-(?:512|1024)\\.png$|admin-apple-touch-icon\\.png$|admin-notification-badge-96\\.png$|intern-icon-(?:192|512|1024)\\.png$|intern-icon-maskable-(?:512|1024)\\.png$|intern-apple-touch-icon\\.png$|intern-notification-badge-96\\.png$|garage-icon-(?:192|512|1024)\\.png$|garage-icon-maskable-(?:512|1024)\\.png$|garage-apple-touch-icon\\.png$|garage-notification-badge-96\\.png$|rovauto-brand-v3-icon-(?:192|512|1024)\\.png$|rovauto-brand-v3-icon-maskable-(?:512|1024)\\.png$|rovauto-brand-v3-apple-touch-icon\\.png$|rovauto-brand-lockup-v3\\.png$|garage\\.html$|admin\\.html$|intern\\.html$|support\\.html$|favicon\\.(?:ico|png)$|favicon-48\\.png$|icon-(?:192|512|1024)\\.png$|icon-maskable-(?:512|1024)\\.png$|apple-touch-icon\\.png$|og-image\\.jpg$|robots\\.txt$|sitemap\\.xml$).*)",
      "destination": "/index.html"
    }
  ]
}
