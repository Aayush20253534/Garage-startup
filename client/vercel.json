{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/api/v1/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/support-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/support"
        }
      ]
    },
    {
      "source": "/((?!api/v1/|assets/).*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/(site|support).webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://rovauto.onrender.com/api/v1/:path*"
    },
    {
      "source": "/support",
      "destination": "/support.html"
    },
    {
      "source": "/support/:path*",
      "destination": "/support.html"
    },
    {
      "source": "/((?!api/v1/|assets/|support(?:/|$)|sw\\.js$|support-sw\\.js$|site\\.webmanifest$|support\\.webmanifest$|support-icon-(?:192|512|1024)\\.png$|support-icon-maskable-(?:512|1024)\\.png$|support-apple-touch-icon\\.png$|support-notification-badge-96\\.png$|favicon\\.(?:ico|png)$|favicon-48\\.png$|icon-(?:192|512|1024)\\.png$|icon-maskable-(?:512|1024)\\.png$|apple-touch-icon\\.png$|og-image\\.jpg$|robots\\.txt$|sitemap\\.xml$).*)",
      "destination": "/index.html"
    }
  ]
}
